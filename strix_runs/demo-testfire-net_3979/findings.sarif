              "surface": "State-changing web forms (POST /bank/doTransfer, /admin/addUser, /admin/changePassword, /sendFeedback, /doSubscribe, /bank/customize.jsp)",
              "recorded_by": "Client-Side Session & CSRF Hunter",
              "source": "agent_reported"
            }
          }
