      "results": [
        {
          "ruleId": "strix-coverage/attack-surface-endpoint-amp-parameter-enumeration",
          "ruleIndex": 0,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Attack-surface / endpoint &amp; parameter enumeration — Requires further review: https://testphp.vulnweb.com (whole-host attack surface)\n\nLive host unreachable from sandbox: DNS resolves to 44.228.249.3 (AWS us-west-2) but TCP 80/443 are filtered; proxy returns Caido 502 with cause 'Timeout' (~10s) and direct curl times out (20s); no response ever captured in proxy history (all response:null). Surface mapped instead from Wayback CDX + archived snapshots: ~24 core PHP scripts, /AJAX/, /Mod_Rewrite_Shop/, /hpp/, plus sensitive paths (/.idea/, /CVS/, /Connections/DB_Connection.php, /admin/create.sql, /_mmServerScripts/MMHTTPDB.php, /index.bak, /index.zip, /bxss/). 50+ query params enumerated; verbose PHP errors leak /hj/var/www path. Live validation of existence, cookies, and injection behavior blocked by reachability."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "https://testphp.vulnweb.com (whole-host attack surface)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "Attack-surface / endpoint &amp; parameter enumeration",
              "surface": "https://testphp.vulnweb.com (whole-host attack surface)",
              "recorded_by": "Lean Surface Mapper",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/authentication-bypass-weak-credentials-session-cookie-flags",
          "ruleIndex": 1,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Authentication bypass / weak credentials / session cookie flags — Requires further review: POST /login.php (auth, credentials, session cookie)\n\nTarget unreachable: TCP 80/443 filtered (nmap no-response), Caido proxy 502 Timeout, and independent fetchers (r.jina.ai, Google translate proxy, archive.org SPN) also timeout while controls (example.com) succeed. Could not send any login request, so test/test, bypasses, and Set-Cookie flags (HttpOnly/Secure/SameSite) remain untested."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "POST /login.php (auth, credentials, session cookie)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "Authentication bypass / weak credentials / session cookie flags",
              "surface": "POST /login.php (auth, credentials, session cookie)",
              "recorded_by": "Access Control & Auth Hunter",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/missing-authentication-forced-browsing-cross-user-data-exposure",
          "ruleIndex": 2,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Missing authentication / forced browsing / cross-user data exposure — Requires further review: GET/POST /userinfo.php (forced browsing / missing auth)\n\nTarget unreachable (TCP 80/443 filtered; proxy and independent fetchers timeout). Could not issue authenticated vs unauthenticated requests, so whether userinfo.php renders another user's data without a valid session is untested."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "GET/POST /userinfo.php (forced browsing / missing auth)"
                }
              ]
            }
          ],
          "properties": {
