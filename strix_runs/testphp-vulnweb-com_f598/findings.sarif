        {
          "ruleId": "strix-coverage/mass-assignment-privilege-fields-account-creation-abuse",
          "ruleIndex": 4,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Mass assignment / privilege fields / account-creation abuse — Requires further review: POST /signup.php -> /secured/newuser.php\n\nTarget unreachable. Archived HTML shows fixed fields uuname/upass/upass2/uemail/urname/uphone/ucc with no role field, but server-side binding and whether signup is truly disabled could not be verified live."
          },
