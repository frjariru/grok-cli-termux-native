        },
        {
          "ruleId": "strix-coverage/idor-bola-cross-user-object-access",
          "ruleIndex": 3,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "IDOR / BOLA (cross-user object access) — Requires further review: cart.php / userinfo.php / AJAX/info.php?id= / showimage.php?file= (object references)\n\nTarget unreachable; no live requests possible. ID increment/swap and alternate-user comparisons could not be performed. Note: these params may also be SQLi/traversal sinks (owned by sibling agents)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "cart.php / userinfo.php / AJAX/info.php?id= / showimage.php?file= (object references)"
